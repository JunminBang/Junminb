#!/usr/bin/env python3
"""
텍스처 채널 변경 및 재압축 스크립트

현재 폴더 내의 파일들 중, 파일명이 아래 접미사를 포함하는 텍스처만을 대상으로 자동 그룹화를 진행합니다.
    - _B         → basecolor 이미지 (RGB 채널 사용)
    - _SlopeM    → SlopeM 이미지 (녹색 채널을 basecolor의 알파로 사용)
    - _M         → Mask 이미지 (RGB 채널 사용)
    - _DetailM   → DetailM 이미지 (녹색 채널을 Mask의 알파로 사용)

각 그룹에 대해:
    new_basecolor = (basecolor의 R, G, B) + (SlopeM의 G를 알파로)
    new_Mask      = (Mask의 R, G, B) + (DetailM의 G를 알파로)
    
생성된 이미지는 기존의
    basecolor: [공통이름]_B.png
    mask:      [공통이름]_M.png
파일에 덮어쓰기되며,
처리 후 _SlopeM, _DetailM 파일은 삭제됩니다.
"""

import os
import re
from PIL import Image

def process_group(common_name, group_items):
    # new_basecolor 처리: _B와 _SlopeM 파일 필요
    if "_B" in group_items and "_SlopeM" in group_items:
        try:
            base_img = Image.open(group_items["_B"]).convert("RGB")
        except Exception as e:
            print(f"Error opening basecolor image '{group_items['_B']}': {e}")
            base_img = None

        try:
            slope_img = Image.open(group_items["_SlopeM"]).convert("RGB")
        except Exception as e:
            print(f"Error opening slope image '{group_items['_SlopeM']}': {e}")
            slope_img = None

        if base_img and slope_img:
            if base_img.size != slope_img.size:
                print(f"Size mismatch in group '{common_name}' between basecolor and slope images. Skipping basecolor processing.")
            else:
                # base_img의 R, G, B와 slope_img의 녹색(G)을 알파 채널로 사용
                r, g, b = base_img.split()
                _, slope_g, _ = slope_img.split()
                new_base = Image.merge("RGBA", (r, g, b, slope_g))
                # 기존 _B 파일에 덮어쓰기
                out_name = f"{common_name}_B.png"
                new_base.save(out_name, optimize=True)
                print(f"Saved new basecolor image (overwritten): {out_name}")
    else:
        print(f"Group '{common_name}' is missing basecolor (_B) or slope (_SlopeM) file.")

    # new_Mask 처리: _M와 _DetailM 파일 필요
    if "_M" in group_items and "_DetailM" in group_items:
        try:
            mask_img = Image.open(group_items["_M"]).convert("RGB")
        except Exception as e:
            print(f"Error opening mask image '{group_items['_M']}': {e}")
            mask_img = None

        try:
            detail_img = Image.open(group_items["_DetailM"]).convert("RGB")
        except Exception as e:
            print(f"Error opening detail image '{group_items['_DetailM']}': {e}")
            detail_img = None

        if mask_img and detail_img:
            if mask_img.size != detail_img.size:
                print(f"Size mismatch in group '{common_name}' between mask and detail images. Skipping mask processing.")
            else:
                mr, mg, mb = mask_img.split()
                _, detail_g, _ = detail_img.split()
                new_mask = Image.merge("RGBA", (mr, mg, mb, detail_g))
                # 기존 _M 파일에 덮어쓰기
                out_mask_name = f"{common_name}_M.png"
                new_mask.save(out_mask_name, optimize=True)
                print(f"Saved new mask image (overwritten): {out_mask_name}")
    else:
        print(f"Group '{common_name}' is missing mask (_M) or detail (_DetailM) file.")

    # 처리 후 사용된 _SlopeM 및 _DetailM 파일 삭제
    for tag in ("_SlopeM", "_DetailM"):
        if tag in group_items:
            try:
                os.remove(group_items[tag])
                print(f"Deleted file: {group_items[tag]}")
            except Exception as e:
                print(f"Error deleting file {group_items[tag]}: {e}")

def main():
    # 현재 디렉터리 내의 파일들을 검색
    all_files = [f for f in os.listdir('.') if os.path.isfile(f)]
    
    # 그룹화: 파일명에서 접미사(_B, _SlopeM, _DetailM, _M)를 추출하여 공통이름 별로 분류
    groups = {}
    pattern = re.compile(r"(.*?)(_B|_SlopeM|_DetailM|_M)(\.[^.]+)$", re.IGNORECASE)
    
    for file_name in all_files:
        match = pattern.fullmatch(file_name)
        if not match:
            continue  # 패턴에 맞지 않으면 건너뜀
        common_name = match.group(1)
        tag = match.group(2)  # 예: _B, _SlopeM, 등
        groups.setdefault(common_name, {})[tag] = file_name
    
    if not groups:
        print("매칭되는 텍스처 파일이 현재 폴더 내에 없습니다.")
        return
    
    # 각 그룹별로 처리
    for common_name, items in groups.items():
        print(f"\nProcessing group: '{common_name}'")
        process_group(common_name, items)

if __name__ == "__main__":
    main()
